# wifi.nix.example  
# Template for WiFi network configuration
# Copy this file to personal/wifi.nix and customize with your network settings

{ config, lib, ... }:

{
  # Override the default WiFi configuration
  pihole.networking.wifi = {
    enable = true;
    interface = "wlan0";  # Change if your WiFi interface is different
  };

  # Example: Disable WiFi entirely for ethernet-only setups
  # pihole.networking.wifi.enable = false;

  # The actual WiFi credentials should be defined in secrets.nix:
  # {
  #   wifi = {
  #     networkName = "YOUR_WIFI_NETWORK";
  #     password = "YOUR_WIFI_PASSWORD"; 
  #   };
  # }
}