# secrets.nix.example
# Copy this file to secrets.nix and customize with your actual values
# secrets.nix is gitignored to prevent accidental commits of sensitive information

{
  # WiFi network configuration
  wifi = {
    # Replace with your actual WiFi network name
    networkName = "YOUR_WIFI_NETWORK";
    # Replace with your actual WiFi password
    password = "YOUR_WIFI_PASSWORD";
  };

  # Root password hash (generate with: mkpasswd -m sha-512)
  # You can also generate with: python3 -c "import crypt; print(crypt.crypt('password', crypt.mksalt(crypt.METHOD_SHA512)))"
  rootPassword = "$6$rounds=4096$salthere$hashhere";

  # SSH public keys for user authentication
  # Generate your SSH key with: ssh-keygen -t ed25519 -C "your_email@example.com"
  # Get the public key content with: cat ~/.ssh/id_ed25519.pub
  sshKeys = {
    # Replace with your actual SSH public key(s)
    # Example: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIxxx... user@hostname"
    users = [
      "ssh-rsa YOUR_SSH_PUBLIC_KEY_HERE user@hostname"
    ];
  };
}