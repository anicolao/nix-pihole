# users.nix.example
# Template for personal user configuration
# Copy this file to personal/users.nix and customize with your actual values

{pkgs, ...}: let
  secrets = import ./secrets.nix;
in {
  users.users.root = {
    initialHashedPassword = secrets.rootPassword;
    openssh.authorizedKeys.keys = secrets.sshKeys.users;
  };

  # Example additional user - customize as needed
  users.extraUsers.myuser = {
    createHome = true;
    home = "/home/myuser";
    description = "My User Account";
    group = "users";
    extraGroups = ["wheel" "dialout"];
    shell = pkgs.zsh;
    isSystemUser = true;
    initialHashedPassword = secrets.rootPassword;
    openssh.authorizedKeys.keys = secrets.sshKeys.users;
  };
}